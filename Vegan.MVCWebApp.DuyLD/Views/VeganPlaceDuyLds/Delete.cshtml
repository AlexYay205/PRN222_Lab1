<script src="~/lib/jquery/dist/jquery.min.js"></script>

<script src="~/js/signalr/dist/browser/signalr.js"></script>

<script>
    const connection = new signalR.HubConnectionBuilder()
        .withUrl("/veganHub")
        .build();

    connection.start().catch(err => console.error(err.toString()));

    $("#btnDeleteBySignalR").on("click", function () {
        const id = "@Model.VeganPlaceDuyLdid";

        connection.invoke("HubDelete_VeganPlaceServiceDuyLd", id)
            .then(function () {
                alert("Data had been delete");
                window.location.href = "/VeganPlaceDuyLds";
            })
            .catch(err => console.error(err.toString()));
    });

    connection.on("Receiver_DeleteVeganPlaceServiceDuyLd", function (id) {
        $("#depositTableBodyID").find("#vegan-place-" + id).remove();
    });

</script>
