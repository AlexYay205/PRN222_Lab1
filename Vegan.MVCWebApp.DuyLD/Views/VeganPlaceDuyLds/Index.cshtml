@model IEnumerable<Vegan.Entities.DuyLD.Models.VeganPlaceDuyLd>

@{
    ViewData["Title"] = "Deposit";
    var places = Model?.ToList() ?? new List<Vegan.Entities.DuyLD.Models.VeganPlaceDuyLd>();
    var totalPlaces = places.Count;
    var activePlaces = places.Count(p => p.IsActive);
    var categoryCount = places
        .Where(p => !string.IsNullOrWhiteSpace(p.CategoryName))
        .Select(p => p.CategoryName)
        .Distinct()
        .Count();
    var ratedPlaces = places.Where(p => p.Rating.HasValue).ToList();
    var averageRating = ratedPlaces.Any() ? ratedPlaces.Average(p => p.Rating!.Value) : 0;
    var placeSearch = ViewData["PlaceSearch"] as string ?? string.Empty;
    var categorySearch = ViewData["CategorySearch"] as string ?? string.Empty;
    var statusSearch = ViewData["StatusSearch"] as string ?? string.Empty;
    var hasSearchCondition = !string.IsNullOrWhiteSpace(placeSearch)
        || !string.IsNullOrWhiteSpace(categorySearch)
        || !string.IsNullOrWhiteSpace(statusSearch);
}

<section class="deposit-shell">
    <div class="deposit-header">
        <div>
            <p class="deposit-eyebrow">Vegan places</p>
            <h1>Deposit</h1>
            <p class="deposit-subtitle">Manage vegan locations, categories, ratings, and availability from one place.</p>
        </div>
        <a class="btn btn-primary deposit-primary-action" asp-action="Create">Create New</a>
    </div>

    <div class="deposit-metrics" aria-label="Deposit summary">
        <div class="deposit-metric">
            <span>Total places</span>
            <strong id="totalPlacesMetric">@totalPlaces</strong>
        </div>
        <div class="deposit-metric">
            <span>Active</span>
            <strong id="activePlacesMetric">@activePlaces</strong>
        </div>
        <div class="deposit-metric">
            <span>Categories</span>
            <strong id="categoryCountMetric">@categoryCount</strong>
        </div>
        <div class="deposit-metric">
            <span>Avg rating</span>
            <strong id="averageRatingMetric">@averageRating.ToString("0.0")</strong>
        </div>
    </div>

    <form class="deposit-toolbar deposit-search-form" asp-action="Index" method="get">
        <div class="deposit-search">
            <label class="form-label" for="placeSearch">Place</label>
            <input id="placeSearch" name="place" class="form-control" type="search" value="@placeSearch" placeholder="Search by place name" autocomplete="off" />
        </div>

        <div class="deposit-search">
            <label class="form-label" for="categorySearch">Category</label>
            <input id="categorySearch" name="category" class="form-control" type="search" value="@categorySearch" placeholder="Search by category" autocomplete="off" />
        </div>

        <div class="deposit-search">
            <label class="form-label" for="statusSearch">Status</label>
            <input id="statusSearch" name="status" class="form-control" type="search" value="@statusSearch" placeholder="Active or Inactive" autocomplete="off" list="statusOptions" />
            <datalist id="statusOptions">
                <option value="Active"></option>
                <option value="Inactive"></option>
            </datalist>
        </div>

        <div class="deposit-search-actions">
            <button class="btn btn-primary deposit-primary-action" type="submit">Search</button>
            <a class="btn btn-outline-secondary" asp-action="Index">Clear</a>
        </div>
    </form>

    <div class="deposit-table-wrap">
        <table id="tblDepositList" class="table deposit-table align-middle">
            <thead>
                <tr>
                    <th>ID</th>
                    <th>Place</th>
                    <th>Category</th>
                    <th>Contact</th>
                    <th>Rating</th>
                    <th>Status</th>
                    <th>Created</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>

            <tbody id="depositTableBodyID">
                @if (!places.Any())
                {
                    <tr>
                        <td colspan="8" class="deposit-empty">@(hasSearchCondition ? "No matching places." : "No places yet.")</td>
                    </tr>
                }
                else
                {
                    foreach (var item in places)
                    {
                        var status = item.IsActive ? "active" : "inactive";
                        var categoryName = string.IsNullOrWhiteSpace(item.CategoryName) ? "Uncategorized" : item.CategoryName;
                        <tr id="vegan-place-@item.VeganPlaceDuyLdid" data-place-id="@item.VeganPlaceDuyLdid" data-place="@item.PlaceName.ToLowerInvariant()" data-category="@categoryName.ToLowerInvariant()" data-status="@status">
                            <td class="deposit-id-cell">@item.VeganPlaceDuyLdid</td>
                            <td class="deposit-place-cell">
                                <strong>@item.PlaceName</strong>
                                <span>@item.Address</span>
                            </td>
                            <td>
                                <span class="deposit-category">@categoryName</span>
                            </td>
                            <td class="deposit-contact-cell">
                                @if (!string.IsNullOrWhiteSpace(item.Phone))
                                {
                                    <span>@item.Phone</span>
                                }
                                @if (!string.IsNullOrWhiteSpace(item.Website))
                                {
                                    <a href="@item.Website" target="_blank" rel="noopener noreferrer">Website</a>
                                }
                            </td>
                            <td>
                                @if (item.Rating.HasValue)
                                {
                                    <span class="deposit-rating">@item.Rating.Value.ToString("0.0")</span>
                                }
                                else
                                {
                                    <span class="deposit-muted">N/A</span>
                                }
                            </td>
                            <td>
                                <span class="deposit-status deposit-status-@status">@(item.IsActive ? "Active" : "Inactive")</span>
                            </td>
                            <td>@item.CreatedAt.ToString("dd/MM/yyyy")</td>
                            <td>
                                <div class="deposit-actions">
                                    <a class="btn btn-sm btn-outline-primary" asp-action="Details" asp-route-id="@item.VeganPlaceDuyLdid">Details</a>
                                    <a class="btn btn-sm btn-outline-secondary" asp-action="Edit" asp-route-id="@item.VeganPlaceDuyLdid">Edit</a>
                                    <a class="btn btn-sm btn-outline-danger" asp-action="Delete" asp-route-id="@item.VeganPlaceDuyLdid">Delete</a>
                                </div>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
        <div id="depositPagination" class="deposit-pagination" aria-label="Deposit pagination"></div>
    </div>
</section>

@section Scripts {
    <script>
        (() => {
            const pagination = document.getElementById('depositPagination');
            const rowsPerPage = 5;
            let currentPage = 1;

            const getRows = () => Array.from(document.querySelectorAll('#tblDepositList tbody tr[data-place]'));

            const getTotalPages = () => Math.ceil(getRows().length / rowsPerPage);

            const normalizeCurrentPage = () => {
                const totalPages = getTotalPages();
                currentPage = Math.min(currentPage, Math.max(totalPages, 1));
            };

            const renderRows = () => {
                const rows = getRows();
                const startIndex = (currentPage - 1) * rowsPerPage;
                const endIndex = startIndex + rowsPerPage;

                rows.forEach((row, index) => {
                    row.classList.toggle('d-none', index < startIndex || index >= endIndex);
                });
            };

            const createPageButton = (label, page, isActive = false, isDisabled = false) => {
                const button = document.createElement('button');
                button.type = 'button';
                button.className = `deposit-page-btn${isActive ? ' active' : ''}`;
                button.textContent = label;
                button.disabled = isDisabled;

                if (!isDisabled) {
                    button.addEventListener('click', () => {
                        currentPage = page;
                        renderRows();
                        renderPagination();
                    });
                }

                return button;
            };

            const renderPagination = () => {
                normalizeCurrentPage();
                const totalPages = getTotalPages();

                if (!pagination || totalPages <= 1) {
                    if (pagination) pagination.innerHTML = '';
                    return;
                }

                pagination.innerHTML = '';
                pagination.appendChild(createPageButton('Prev', Math.max(1, currentPage - 1), false, currentPage === 1));

                for (let page = 1; page <= totalPages; page += 1) {
                    pagination.appendChild(createPageButton(page.toString(), page, page === currentPage));
                }

                pagination.appendChild(createPageButton('Next', Math.min(totalPages, currentPage + 1), false, currentPage === totalPages));
            };

            window.refreshDepositPagination = (page) => {
                if (Number.isInteger(page)) {
                    currentPage = page;
                }

                normalizeCurrentPage();
                renderRows();
                renderPagination();
            };

            window.refreshDepositPagination();
        })();
    </script>

    <script src="~/js/signalr/dist/browser/signalr.js"></script>

    <script>
        const connection = new signalR.HubConnectionBuilder()
            .withUrl("/veganHub")
            .withAutomaticReconnect()
            .build();

        connection.serverTimeoutInMilliseconds = 120000;
        connection.keepAliveIntervalInMilliseconds = 30000;

        connection.start().catch(err => console.error(err.toString()));

        const refreshDepositMetrics = function () {
            const rows = Array.from(document.querySelectorAll('#tblDepositList tbody tr[data-place]'));
            const activeRows = rows.filter(row => row.dataset.status === 'active');
            const categories = new Set(rows.map(row => row.dataset.category).filter(Boolean));
            const ratings = rows
                .map(row => Number(row.children[4]?.textContent?.trim()))
                .filter(value => !Number.isNaN(value));

            document.getElementById("totalPlacesMetric").textContent = rows.length;
            document.getElementById("activePlacesMetric").textContent = activeRows.length;
            document.getElementById("categoryCountMetric").textContent = categories.size;
            document.getElementById("averageRatingMetric").textContent = ratings.length
                ? (ratings.reduce((total, value) => total + value, 0) / ratings.length).toFixed(1)
                : "0.0";
        };

        connection.on("Receiver_DeleteVeganPlaceServiceDuyLd", function (id) {
            const deletedRow = document.getElementById("vegan-place-" + id);

            if (deletedRow) {
                deletedRow.remove();
                window.refreshDepositPagination?.();
                refreshDepositMetrics();
            }
        });

        connection.on("Receiver_CreateVeganPlaceServiceDuyLd", function (item) {
            $("#depositTableBodyID").find(".deposit-empty").closest("tr").remove();

            var trVeganPlaceDuyLd = `
                <tr class="bg-warning text-danger fw-bold" id="vegan-place-${item.veganPlaceDuyLdid}" data-place="${item.placeName}" data-category="${item.categoryName}" data-status="${item.isActive ? "active" : "inactive"}">
                    <td>${item.veganPlaceDuyLdid}</td>
                    <td>${item.placeName}</td>
                    <td>${item.categoryName}</td>
                    <td>${item.phone}</td>
                    <td>${item.rating}</td>
                    <td>${item.isActive ? "Active" : "Inactive"}</td>
                    <td>${item.createdAt}</td>
                    <td></td>
                </tr>
            `;

            $("#depositTableBodyID").append(trVeganPlaceDuyLd);
            window.refreshDepositPagination?.();
            refreshDepositMetrics();
        });

        connection.on("Receiver_UpdateVeganPlaceServiceDuyLd", function (item) {
            var trVeganPlaceDuyLd = `
                <tr class="bg-warning text-danger fw-bold" id="vegan-place-${item.veganPlaceDuyLdid}" data-place="${item.placeName}" data-category="${item.categoryName}" data-status="${item.isActive ? "active" : "inactive"}">
                    <td>${item.veganPlaceDuyLdid}</td>
                    <td>${item.placeName}</td>
                    <td>${item.categoryName}</td>
                    <td>${item.phone}</td>
                    <td>${item.rating}</td>
                    <td>${item.isActive ? "Active" : "Inactive"}</td>
                    <td>${item.createdAt}</td>
                    <td></td>
                </tr>
            `;

            $("#vegan-place-" + item.veganPlaceDuyLdid).replaceWith(trVeganPlaceDuyLd);
            window.refreshDepositPagination?.();
            refreshDepositMetrics();
        });

    </script>

}
